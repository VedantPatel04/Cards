# Shared settings live in config/settings/{base,local,test,production}.py.
# Copy this file to backend/.env and fill in real values. Never commit .env.

# Required for local Django (config.settings.local)
# Host Postgres example (Django on your machine):
DATABASE_URL=postgres://USER:PASSWORD@localhost:5432/cards_db
# docker-compose web service uses the compose-provided DATABASE_URL instead.

# Optional locally; required in production
SECRET_KEY=replace-me-with-a-long-random-string

# Redis — merchant category L1 cache
REDIS_URL=redis://localhost:6379/0
MERCHANT_CACHE_TTL=2592000

# Production only (comma-separated). Leave empty until the frontend exists.
# ALLOWED_HOSTS=cards-api.onrender.com
# CORS_ALLOWED_ORIGINS=https://your-app.vercel.app
# CSRF_TRUSTED_ORIGINS=https://your-app.vercel.app
